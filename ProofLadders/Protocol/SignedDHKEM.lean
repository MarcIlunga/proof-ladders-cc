import Commons.Definitions.KEM
import ProofLadders.Common.KeyExchange

/-!
# Signed Diffie–Hellman with a KEM

Problem 4 of the protocol ladder [1, §2.4]: the hybrid of signed Diffie–Hellman with a KEM. It is
a unilateral authenticated two-pass key exchange, so it is stated in the syntax of [2] as
`KE₄`, over a group `G` of prime order `p` generated by `g`, a signature scheme `SIG`, the
Commons KEM `kem`, and a hash function `Hash : G × SS → K` modeled as a random oracle.

$$\mathsf{init}(s_{pk}):\ x \leftarrow \mathbb{Z}_p,\ (z_{pk}, z_{sk}) \leftarrow
\mathsf{KEM.gen},\ c = (g^x, z_{pk});$$
$$\mathsf{resp}(s_{sk}, (X, z_{pk})):\ y \leftarrow \mathbb{Z}_p,\ (ct, ss) \leftarrow
\mathsf{encaps}(z_{pk}),\ \sigma \leftarrow \mathsf{sign}((X, g^y, z_{pk}, ct), s_{sk}),\
k_S = \mathsf{Hash}(X^y, ss);$$
$$\mathsf{recv}:\ \text{abort unless } \mathsf{verify}(\sigma, (g^x, g^y, z_{pk}, ct), s_{pk}),
\ ss \leftarrow \mathsf{decaps}(ct, z_{sk}),\ k_C = \mathsf{Hash}((g^y)^x, ss).$$

The problem set gives no computational security definition for this protocol and the notes of
[2] no theorem, so its security in the game `IND` of [2] is not stated.

## Main definitions

* `KE₄ sig kem p g`: signed Diffie–Hellman with a KEM

## Main results

* `signed_dh_kem_correct`: correctness, from the correctness of `SIG` and of the KEM

## References

1. The protocol ladder, `proof-ladders/protocol-ladder`, `Notes/main.tex`.
2. D. Riepel and P. Rösler. *Basic definitions, constructions, and proofs for unilateral
   authenticated key exchange*. The protocol ladder, `Notes/computational/main.pdf`, 2025.
-/

namespace ProofLadders.SignedDHKEM

open Commons Probability SystemAlgebra SystemAlgebra.DSL
open scoped SystemAlgebra.DSL

noncomputable section

variable {G : Type} [Group G] [Fintype G] [DecidableEq G] {p : ℕ} [NeZero p]
  {PK SK Sig KPK KSK CT SS K : Type} [Fintype KPK] [Fintype KSK] [DecidableEq KPK]
  [DecidableEq KSK] [Fintype CT] [Fintype SS] [DecidableEq CT] [DecidableEq SS]

/-- **Signed Diffie–Hellman with a KEM** `KE₄` [1, §2.4]. -/
def KE₄ (sig : SignatureScheme PK SK (G × G × KPK × CT) Sig) (kem : KEM KPK KSK CT SS)
    (p : ℕ) [NeZero p] (g : G) :
    KeyExchange (G × SS) K PK SK (PK × ZMod p × KPK × KSK) (G × KPK) (G × Sig × CT) K where
  gen := Distribution.ProbDist.map Prod.swap sig.gen
  init _ pk := Distribution.ProbDist.bind 𝒰[ZMod p] fun x =>
    Distribution.ProbDist.map (fun z => ((pk, x, z.1, z.2), (g ^ x.val, z.1))) kem.gen
  resp H sk c := Distribution.ProbDist.bind 𝒰[ZMod p] fun y =>
    Distribution.ProbDist.bind (kem.encaps c.2) fun encapsulation =>
      Distribution.ProbDist.map
        (fun σ => (some (H (c.1 ^ y.val, encapsulation.2)), (g ^ y.val, σ, encapsulation.1)))
        (sig.sign sk (c.1, g ^ y.val, c.2, encapsulation.1))
  recv H st c' :=
    if sig.verify st.1 (g ^ st.2.1.val, c'.1, st.2.2.1, c'.2.2) c'.2.1 then
      (kem.decaps st.2.2.2 c'.2.2).map fun ss => H (c'.1 ^ st.2.1.val, ss)
    else none

omit [Fintype G] [DecidableEq G] [Fintype KPK] [Fintype KSK] [DecidableEq KPK] [DecidableEq KSK] in
/-- **Correctness**: if `SIG` and the KEM are correct, an honestly forwarded session gives both
parties `Hash(g^{xy}, ss)`. -/
theorem signed_dh_kem_correct (sig : SignatureScheme PK SK (G × G × KPK × CT) Sig)
    (kem : KEM KPK KSK CT SS) (g : G) (sigCorrect : sig.Correct) (kemCorrect : kem.Correct) :
    (KE₄ (K := K) sig kem p g).Correct := by
  intro H keys hkeys start hstart response hresponse
  obtain ⟨⟨pk, sk⟩, hpk, rfl⟩ := Distribution.ProbDist.mem_support_map hkeys
  obtain ⟨x, -, hx⟩ := Distribution.ProbDist.mem_support_bind hstart
  obtain ⟨⟨zpk, zsk⟩, hz, rfl⟩ := Distribution.ProbDist.mem_support_map hx
  obtain ⟨y, -, hy⟩ := Distribution.ProbDist.mem_support_bind hresponse
  obtain ⟨⟨ct, ss⟩, hct, hy'⟩ := Distribution.ProbDist.mem_support_bind hy
  obtain ⟨σ, hσ, rfl⟩ := Distribution.ProbDist.mem_support_map hy'
  -- The signature verifies by `sigCorrect`, decapsulation recovers `ss` by `kemCorrect`, and
  -- `(g^y)^x = (g^x)^y`.
  have verifies : sig.verify pk (g ^ x.val, g ^ y.val, zpk, ct) σ = true :=
    sigCorrect pk sk hpk _ σ hσ
  have decapsulates : kem.decaps zsk ct = some ss := kemCorrect zpk zsk hz ct ss hct
  refine ⟨rfl, ?_⟩
  simp only [KE₄, Prod.swap_prod_mk, verifies, decapsulates, if_true, Option.map_some,
    ← pow_mul, mul_comm]

end

end ProofLadders.SignedDHKEM
