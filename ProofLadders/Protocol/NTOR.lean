import ProofLadders.Protocol.MultiUser

/-!
# Simplified NTOR

Problem 5 of the protocol ladder [1, §2.5], in the computational model of [2]: the simplified
NTOR key exchange `KE₅` [2, Figure 11] over a group `G` of prime order `p` generated by `g`, with
a hash function `Hash : G⁵ → K²` modeled as a random oracle. The responder's long-term key is a
Diffie–Hellman key `(sk, g^{sk})`.

$$\mathsf{resp}(sk, c):\ y \leftarrow \mathbb{Z}_p,\ (\mathit{auth}, k) = \mathsf{Hash}(c, g^y,
g^{sk}, c^y, c^{sk});$$
$$\mathsf{recv}((pk, x), (g^y, \mathit{auth}))\text{: } (\mathit{auth}', k) =
\mathsf{Hash}(g^x, g^y, pk, (g^y)^x, pk^x), \text{ and } k \text{ if } \mathit{auth}' =
\mathit{auth}, \bot \text{ otherwise}.$$

Following [2, Remark 6], both values are derived directly, rather than through the key `mk` of the
problem set. Theorem 2 of [2] bounds the key-indistinguishability advantage by twice the
advantage of the adversary `B₁` against `(q_gen, q_init)`-St-CDH, the advantage of the adversary
`B₂` against `(q_init, q_resp)`-St-CDH, and the statistical terms `2 q_init/|K|`,
`2 q_gen q_init/p` and `2 q_H (q_init + q_resp)/p`. The advantage is a solver's difference of
decision probabilities between `IND⁰` and `IND¹`, the converter `KeyExchange.IND b` on the real
system of `KE₅`; the adversaries are the solver with the reductions of [2, Figures 13 and 14]
absorbed, one `B₁ b` for each value of the challenge bit, and their advantages are winning
probabilities of the multi-user games.

The reductions are DSL converters from the key-exchange interface to the multi-user St-CDH game.
Both run `G₄` of [2], with the internal oracles `H₁` (partnered responses), `H₂` (unpartnered
responses, whose exponents `RS` are kept) and `H₃` (initiators' messages with the adversary's
`Y`), and answer an oracle query at Diffie–Hellman values from them. `B₁ b` takes the long-term
keys from `Gen₁` and the initiators' messages from `Gen₂`, answers `Corrupt` and `Expose` with
`Corrupt₁` and `Corrupt₂`, and checks both values of an oracle query with `DDH`: `Z₂` against
the long-term key and `Z₁` against the initiator's message. `B₂` takes the initiators' messages
from `Gen₁` and partnered responses from `Gen₂`, samples the long-term keys itself, and checks
`Z₁` with `DDH`. As in `IND`, a `Respond` is partnered with every initiator of intended partner
`j` that sent `c`: its reply is recorded for all of them, keyed with `H₁`, and challenged when
none of them is exposed. After `Stop` a reduction makes no inside call and answers `⊥`, and the
oracle from its table. The oracles are sampled once, as in `IND`: `H`, and `H₁`, `H₂`, `H₃` as the
three components of one function `internal`; the points where the tables of `H` and `H₃` are
set are recorded. Each reduction is typed at per-label inside budgets
(`Interface.Converter.ofLabelBoundedProgram`): `B₁ b` makes two `DDH` queries per oracle query
and `B₂` one.

Corollary 2 of [2] composes `B₁ b` with the reduction of Lemma 1, losing `q_gen q_init`, and
`B₂`, which has no `Corrupt₂`, with that of Lemma 1 without `Corrupt₂`, losing `q_init`; the
factor `2 q_gen q_init` of [2] is the sum over the two bits. As printed, Corollary 2 names an
adversary `B₁` against SUF-CMA; its bound and Theorem 2 make it an adversary against St-CDH.

Style: systems for the key exchange and games for the assumptions, as for signed Diffie–Hellman:
the games `G₀`–`G₄` of [2] are hybrids, with statistical steps and two strong-CDH steps.

## Main definitions

* `KE₅ p g`: simplified NTOR
* `B₁ K p g b`, `B₂ K p g`: the reductions of [2, Figures 13 and 14], and their typings
  `.perLabel` at per-label inside budgets
* `cdhBudget₁`, `cdhBudget₂`: the budgets of `B₁` and `B₂`

## Main results

* `ntor_correct`: correctness
* `ntor`: Theorem 2 of [2]
* `ntor_single_user`: Corollary 2 of [2]

## References

1. The protocol ladder, `proof-ladders/protocol-ladder`, `Notes/main.tex`.
2. D. Riepel and P. Rösler. *Basic definitions, constructions, and proofs for unilateral
   authenticated key exchange*. The protocol ladder, `Notes/computational/main.pdf`, 2025.
-/

namespace ProofLadders.NTOR

open CategoryTheory ConstructiveCryptography Commons Probability SystemAlgebra SystemAlgebra.DSL
  SystemAlgebra.Interface
open scoped SystemAlgebra SystemAlgebra.DSL

noncomputable section

variable {G : Type} [Group G] [Fintype G] [DecidableEq G] {K : Type} [Fintype K]

/-- **Simplified NTOR** `KE₅` [2, Figure 11]. -/
def KE₅ [DecidableEq K] (p : ℕ) [NeZero p] (g : G) :
    KeyExchange (G × G × G × G × G) (K × K) G (ZMod p) (G × ZMod p) G (G × K) K where
  gen := Distribution.ProbDist.map (fun sk => (sk, g ^ sk.val)) 𝒰[ZMod p]
  init _ pk := Distribution.ProbDist.map (fun x => ((pk, x), g ^ x.val)) 𝒰[ZMod p]
  resp H sk c := Distribution.ProbDist.map
    (fun y => ((some (H (c, g ^ y.val, g ^ sk.val, c ^ y.val, c ^ sk.val)).2),
      (g ^ y.val, (H (c, g ^ y.val, g ^ sk.val, c ^ y.val, c ^ sk.val)).1)))
    𝒰[ZMod p]
  recv H st c' :=
    if (H (g ^ st.2.val, c'.1, st.1, c'.1 ^ st.2.val, st.1 ^ st.2.val)).1 = c'.2 then
      some (H (g ^ st.2.val, c'.1, st.1, c'.1 ^ st.2.val, st.1 ^ st.2.val)).2
    else none

omit [Fintype G] [DecidableEq G] [Fintype K] in
/-- **Correctness** [2, §3.2]: an honestly forwarded session gives both parties the key of
`Hash(g^x, g^y, g^{sk}, g^{xy}, g^{x·sk})`, and the initiator accepts the tag. -/
theorem ntor_correct [DecidableEq K] (p : ℕ) [NeZero p] (g : G) : (KE₅ (K := K) p g).Correct := by
  intro H keys hkeys start hstart response hresponse
  obtain ⟨sk, -, rfl⟩ := Distribution.ProbDist.mem_support_map hkeys
  obtain ⟨x, -, rfl⟩ := Distribution.ProbDist.mem_support_map hstart
  obtain ⟨y, -, rfl⟩ := Distribution.ProbDist.mem_support_map hresponse
  -- Both parties hash the same tuple: `(g^y)^x = (g^x)^y` and `(g^{sk})^x = (g^x)^{sk}`.
  refine ⟨rfl, ?_⟩
  simp only [KE₅, ← pow_mul, mul_comm, if_true]

/-- The budget of `B₁` [2]: the `q_gen` and `q_init` challenges, the corruptions and exposures,
and two `DDH` queries per oracle query. -/
def cdhBudget₁ (q : UAKE.Port → ℕ) : MultiStCDH.Port → ℕ
  | .gen₁ => q .gen
  | .gen₂ => q .init
  | .corrupt₁ => q .corrupt
  | .corrupt₂ => q .expose
  | .ddh => 2 * q .hash

/-- The budget of `B₂` [2]: the `q_init` and `q_resp` challenges, the exposures, no `Corrupt₂`,
and `q_H` `DDH` queries. -/
def cdhBudget₂ (q : UAKE.Port → ℕ) : MultiStCDH.Port → ℕ
  | .gen₁ => q .init
  | .gen₂ => q .respond
  | .corrupt₁ => q .expose
  | .corrupt₂ => 0
  | .ddh => q .hash

/-! ## The reductions -/

-- `B₁,b` [2, Figure 13]: `Gen` takes `pk_m ← Gen₁` and stops if an `Init` input `pk_m` has no
-- partner; `Init` takes `c ← Gen₂` and keeps `st = (pk, ⊥)`; `Receive` answers `⊥` unless
-- `H₃(g^x, h, pk)` is set, keys with it, and stops when the challenge is allowed; `Respond(j, c,
-- ch)` keys with `H₁` when initiators `i` with `P[i] = j` sent `c`, recording its reply for all of
-- them, and with `H₂` otherwise; `Corrupt` and `Expose` are `Corrupt₁` and `Corrupt₂`;
-- `H(X, Y, pk, Z₁, Z₂)` at a long-term key `pk_j` with `DDH(pk_j, X, Z₂)` is, at an initiator's
-- message `X` with `DDH(Y, X, Z₁)`, `H₁` if `Y` was a response of `j` recorded for an initiator
-- that sent `X` and `H₃` otherwise, and, at an unpartnered response `Y = g^{RS[Y]}` with
-- `Z₁ = X^{RS[Y]}`, `H₂`.
converter B₁(K : Type) [Fintype K] [Nonempty K] [DecidableEq K] (p : ℕ) [NeZero p] (g : G) (b : Bool) (qgen qinit : ℕ) : UAKE (G × G × G × G × G) (K × K) G (ZMod p) (G × ZMod p) G (G × K) K qgen qinit
  inside cdh : MultiStCDH G p qgen qinit
  initialize
    H ←$ 𝒰[G × G × G × G × G → K × K]
    internal ←$ 𝒰[G × G × G → (K × K) × (K × K) × (K × K)]
    defined ← ([] : List (G × G × G × G × G))
    defined₃ ← ([] : List (G × G × G))
    RS ← ([] : List (G × ZMod p))
    pks ← ([] : List G)
    sessions ← ([] : List (G × G × Option (Fin qgen)))
    received ← ([] : List (Fin qinit))
    challenged ← ([] : List (Fin qinit))
    exposed ← ([] : List (Fin qinit))
    corrupted ← ([] : List (Fin qgen))
    responses ← ([] : List (Fin qgen × Fin qinit × (G × K)))
    stopped ← false
  on gen() → Option G
    if stopped
      return none
    else
      if pks.length < qgen
        issued ← cdh.gen₁()
        match issued
        | none →
          return none
        | some pk →
          pks ← pks ++ [pk]
          if decide (∃ s ∈ sessions, s.1 = pk ∧ s.2.2 = none)
            stopped ← true
            return none
          else
            return some pk
      else
        return none
  on init(pk : G) → Option G
    if stopped
      return none
    else
      if sessions.length < qinit
        issued ← cdh.gen₂()
        match issued
        | none →
          return none
        | some c →
          sessions ← sessions ++ [(pk, c,
            (List.finRange qgen).find? fun j => decide (pks[j.val]? = some pk))]
          return some c
      else
        return none
  on receive(i : Fin qinit, c : G × K, ch : Bool) → Option (Option K)
    if stopped
      return none
    else
      match sessions[i.val]?
      | none →
        return none
      | some (pk, c₁, P) →
        if decide (i ∈ received)
          return none
        else
          received ← received ++ [i]
          if decide (∃ j, P = some j ∧ (j, i, c) ∈ responses)
            return none
          else
            if decide ((c₁, c.1, pk) ∉ defined₃)
              return some none
            else
              (auth', k) ← (internal (c₁, c.1, pk)).2.2
              k ← if auth' = c.2 then some k else none
              if (ch && !decide (i ∈ exposed) && decide (∃ j, P = some j ∧ j ∉ corrupted) &&
                  k.isSome)
                stopped ← true
                return none
              else
                return some k
  on respond(j : Fin qgen, c : G, ch : Bool) → Option (Option K × (G × K))
    if stopped
      return none
    else
      match pks[j.val]?
      | none →
        return none
      | some pk →
        y ←$ 𝒰[ZMod p]
        partners ← (List.finRange qinit).filter (fun i =>
          decide (((sessions[i.val]?).map fun s => (s.2.2, s.2.1)) = some (some j, c)))
        if decide (partners = [])
          RS ← RS ++ [(g ^ y.val, y)]
          (auth, k) ← (internal (c, g ^ y.val, pk)).2.1
          return some (some k, (g ^ y.val, auth))
        else
          (auth, k) ← (internal (c, g ^ y.val, pk)).1
          responses ← responses ++ partners.map fun i => (j, i, (g ^ y.val, auth))
          if ch && decide (∀ i ∈ partners, i ∉ exposed)
            challenged ← challenged ++ partners
            if b
              k ←$ 𝒰[K]
              return some (some k, (g ^ y.val, auth))
            else
              return some (some k, (g ^ y.val, auth))
          else
            return some (some k, (g ^ y.val, auth))
  on corrupt(j : Fin qgen) → Option (ZMod p)
    if stopped
      return none
    else
      match pks[j.val]?
      | none →
        return none
      | some _ →
        corrupted ← corrupted ++ [j]
        sk ← cdh.corrupt₁(j)
        return sk
  on expose(i : Fin qinit) → Option (G × ZMod p)
    if stopped
      return none
    else
      if decide (i ∈ challenged)
        return none
      else
        match sessions[i.val]?
        | none →
          return none
        | some (pk, _, _) →
          exposed ← exposed ++ [i]
          x ← cdh.corrupt₂(i)
          return x.map fun x => (pk, x)
  on hash(X : G, Y : G, pk : G, Z₁ : G, Z₂ : G) → K × K
    if stopped
      return H (X, Y, pk, Z₁, Z₂)
    else
      if decide ((X, Y, pk, Z₁, Z₂) ∈ defined)
        return H (X, Y, pk, Z₁, Z₂)
      else
        match (List.finRange qgen).find? fun j => decide (pks[j.val]? = some pk)
        | none →
          defined ← defined ++ [(X, Y, pk, Z₁, Z₂)]
          return H (X, Y, pk, Z₁, Z₂)
        | some j →
          valid₂ ← cdh.ddh(pk, X, Z₂)
          if valid₂
            match (List.finRange qinit).find? fun i =>
                decide (((sessions[i.val]?).map fun s => (s.2.2.isSome, s.2.1)) = some (true, X))
            | some _ →
              valid₁ ← cdh.ddh(Y, X, Z₁)
              if valid₁
                partner ← ((List.finRange qinit).find? fun i =>
                  decide (((sessions[i.val]?).map fun s => (s.2.2, s.2.1)) = some (some j, X)))
                if (partner.any fun i =>
                    decide (∃ r ∈ responses, r.1 = j ∧ r.2.1 = i ∧ r.2.2.1 = Y))
                  return (internal (X, Y, pk)).1
                else
                  defined₃ ← defined₃ ++ [(X, Y, pk)]
                  return (internal (X, Y, pk)).2.2
              else
                defined ← defined ++ [(X, Y, pk, Z₁, Z₂)]
                return H (X, Y, pk, Z₁, Z₂)
            | none →
              match RS.find? fun r => decide (r.1 = Y)
              | some (_, y) →
                if Z₁ = X ^ y.val
                  return (internal (X, Y, pk)).2.1
                else
                  defined ← defined ++ [(X, Y, pk, Z₁, Z₂)]
                  return H (X, Y, pk, Z₁, Z₂)
              | none →
                defined ← defined ++ [(X, Y, pk, Z₁, Z₂)]
                return H (X, Y, pk, Z₁, Z₂)
          else
            defined ← defined ++ [(X, Y, pk, Z₁, Z₂)]
            return H (X, Y, pk, Z₁, Z₂)

-- `B₂` [2, Figure 14]: `Gen` samples `sk_m` and stops if an `Init` input `g^{sk_m}` has no
-- partner; `Init` takes `c ← Gen₁` and keeps `st = (pk, ⊥)`; `Receive` as in `B₁`; `Respond` takes
-- `h ← Gen₂` and keys with `H₁` when partnered, as in `B₁`, and otherwise samples `y`, records
-- `RS[g^y] = y` and keys with `H₂`; `Expose(i)` is `(pk, Corrupt₁(i))`; `H(X, Y, pk, Z₁, Z₂)` at a
-- long-term key with `Z₂ = X^{sk_j}` is, at an initiator's message `X` with `DDH(X, Y, Z₁)`, `H₁`
-- if `Y` was a response of `j` recorded for an initiator that sent `X` and `H₃` otherwise, and,
-- at `Y = g^{RS[Y]}` with `Z₁ = X^{RS[Y]}`, `H₂`.
converter B₂(K : Type) [Fintype K] [Nonempty K] [DecidableEq K] (p : ℕ) [NeZero p] (g : G) (qgen qinit qresp : ℕ) : UAKE (G × G × G × G × G) (K × K) G (ZMod p) (G × ZMod p) G (G × K) K qgen qinit
  inside cdh : MultiStCDH G p qinit qresp
  initialize
    H ←$ 𝒰[G × G × G × G × G → K × K]
    internal ←$ 𝒰[G × G × G → (K × K) × (K × K) × (K × K)]
    defined ← ([] : List (G × G × G × G × G))
    defined₃ ← ([] : List (G × G × G))
    RS ← ([] : List (G × ZMod p))
    keys ← ([] : List (ZMod p × G))
    sessions ← ([] : List (G × G × Option (Fin qgen)))
    received ← ([] : List (Fin qinit))
    challenged ← ([] : List (Fin qinit))
    exposed ← ([] : List (Fin qinit))
    corrupted ← ([] : List (Fin qgen))
    responses ← ([] : List (Fin qgen × Fin qinit × (G × K)))
    stopped ← false
  on gen() → Option G
    if stopped
      return none
    else
      if keys.length < qgen
        sk ←$ 𝒰[ZMod p]
        keys ← keys ++ [(sk, g ^ sk.val)]
        if decide (∃ s ∈ sessions, s.1 = g ^ sk.val ∧ s.2.2 = none)
          stopped ← true
          return none
        else
          return some (g ^ sk.val)
      else
        return none
  on init(pk : G) → Option G
    if stopped
      return none
    else
      if sessions.length < qinit
        issued ← cdh.gen₁()
        match issued
        | none →
          return none
        | some c →
          sessions ← sessions ++ [(pk, c,
            (List.finRange qgen).find? fun j => decide ((keys[j.val]?).map Prod.snd = some pk))]
          return some c
      else
        return none
  on receive(i : Fin qinit, c : G × K, ch : Bool) → Option (Option K)
    if stopped
      return none
    else
      match sessions[i.val]?
      | none →
        return none
      | some (pk, c₁, P) →
        if decide (i ∈ received)
          return none
        else
          received ← received ++ [i]
          if decide (∃ j, P = some j ∧ (j, i, c) ∈ responses)
            return none
          else
            if decide ((c₁, c.1, pk) ∉ defined₃)
              return some none
            else
              (auth', k) ← (internal (c₁, c.1, pk)).2.2
              k ← if auth' = c.2 then some k else none
              if (ch && !decide (i ∈ exposed) && decide (∃ j, P = some j ∧ j ∉ corrupted) &&
                  k.isSome)
                stopped ← true
                return none
              else
                return some k
  on respond(j : Fin qgen, c : G, ch : Bool) → Option (Option K × (G × K))
    if stopped
      return none
    else
      match keys[j.val]?
      | none →
        return none
      | some (_, pk) →
        partners ← (List.finRange qinit).filter (fun i =>
          decide (((sessions[i.val]?).map fun s => (s.2.2, s.2.1)) = some (some j, c)))
        if !decide (partners = [])
          issued ← cdh.gen₂()
          match issued
          | none →
            return none
          | some h →
            (auth, k) ← (internal (c, h, pk)).1
            responses ← responses ++ partners.map fun i => (j, i, (h, auth))
            if ch && decide (∀ i ∈ partners, i ∉ exposed)
              challenged ← challenged ++ partners
              return some (some k, (h, auth))
            else
              return some (some k, (h, auth))
        else
          y ←$ 𝒰[ZMod p]
          RS ← RS ++ [(g ^ y.val, y)]
          (auth, k) ← (internal (c, g ^ y.val, pk)).2.1
          return some (some k, (g ^ y.val, auth))
  on corrupt(j : Fin qgen) → Option (ZMod p)
    if stopped
      return none
    else
      corrupted ← corrupted ++ (keys[j.val]?).toList.map fun _ => j
      return (keys[j.val]?).map Prod.fst
  on expose(i : Fin qinit) → Option (G × ZMod p)
    if stopped
      return none
    else
      if decide (i ∈ challenged)
        return none
      else
        match sessions[i.val]?
        | none →
          return none
        | some (pk, _, _) →
          exposed ← exposed ++ [i]
          x ← cdh.corrupt₁(i)
          return x.map fun x => (pk, x)
  on hash(X : G, Y : G, pk : G, Z₁ : G, Z₂ : G) → K × K
    if stopped
      return H (X, Y, pk, Z₁, Z₂)
    else
      if decide ((X, Y, pk, Z₁, Z₂) ∈ defined)
        return H (X, Y, pk, Z₁, Z₂)
      else
        match (List.finRange qgen).find? fun j =>
            decide ((keys[j.val]?).map (fun key => (key.2, X ^ key.1.val)) = some (pk, Z₂))
        | none →
          defined ← defined ++ [(X, Y, pk, Z₁, Z₂)]
          return H (X, Y, pk, Z₁, Z₂)
        | some j →
          match (List.finRange qinit).find? fun i =>
              decide (((sessions[i.val]?).map fun s => (s.2.2.isSome, s.2.1)) = some (true, X))
          | some _ →
            valid₁ ← cdh.ddh(X, Y, Z₁)
            if valid₁
              partner ← ((List.finRange qinit).find? fun i =>
                decide (((sessions[i.val]?).map fun s => (s.2.2, s.2.1)) = some (some j, X)))
              if (partner.any fun i =>
                  decide (∃ r ∈ responses, r.1 = j ∧ r.2.1 = i ∧ r.2.2.1 = Y))
                return (internal (X, Y, pk)).1
              else
                defined₃ ← defined₃ ++ [(X, Y, pk)]
                return (internal (X, Y, pk)).2.2
            else
              defined ← defined ++ [(X, Y, pk, Z₁, Z₂)]
              return H (X, Y, pk, Z₁, Z₂)
          | none →
            match RS.find? fun r => decide (r.1 = Y)
            | some (_, y) →
              if Z₁ = X ^ y.val
                return (internal (X, Y, pk)).2.1
              else
                defined ← defined ++ [(X, Y, pk, Z₁, Z₂)]
                return H (X, Y, pk, Z₁, Z₂)
            | none →
              defined ← defined ++ [(X, Y, pk, Z₁, Z₂)]
              return H (X, Y, pk, Z₁, Z₂)

/-- The inside calls of `B₁` per procedure: one query of `(q_gen, q_init)`-St-CDH per query of
`Gen`, `Init`, `Corrupt` and `Expose`, two `DDH` queries per oracle query, the oracles, and the
exponents and keys it samples. -/
def B₁.calls : UAKE.Port → MultiStCDH.Port ⊕ (Unit ⊕ (Unit ⊕ (Unit ⊕ Unit))) → ℕ
  | .gen, .inl .gen₁ => 1
  | .init, .inl .gen₂ => 1
  | .corrupt, .inl .corrupt₁ => 1
  | .expose, .inl .corrupt₂ => 1
  | .hash, .inl .ddh => 2
  | _, .inr (.inl _) => 1
  | _, .inr (.inr (.inl _)) => 1
  | .respond, .inr (.inr (.inr _)) => 1
  | _, _ => 0

/-- `B₁` calls each inside label at most `B₁.calls` times per procedure. -/
lemma B₁.labelBounded [DecidableEq K] [Nonempty K] (p : ℕ) [NeZero p] (g : G) (b : Bool)
    (qgen qinit : ℕ) : (B₁.body K p g b qgen qinit).LabelBounded B₁.calls := by
  intro s o u
  cases o <;> simp only [B₁.body] <;> cases s <;> dsimp only <;>
    repeat' (first
      | exact Program.labelCallBound_return _ _
      | (refine Program.labelCallBound_call _ _ _ (by decide) fun y => ?_)
      | split)

/-- The inside interface of the program of `B₁`: `(q_gen, q_init)`-St-CDH beside the sources. -/
abbrev B₁.inside [DecidableEq K] [Nonempty K] (p : ℕ) [NeZero p] (g : G) (b : Bool)
    (q : UAKE.Port → ℕ) : Interface :=
  (MultiStCDH.perPort G p (q .gen) (q .init) (cdhBudget₁ q)).tensor
    ((Interface.source (lawType (B₁.law1 K p g b (q .gen) (q .init))) (∑ i, q i)).tensor
      ((Interface.source (lawType (B₁.law2 K p g b (q .gen) (q .init))) (∑ i, q i)).tensor
        ((Interface.source (lawType (B₁.law3 K p g b (q .gen) (q .init))) (∑ i, q i)).tensor
          (Interface.source (lawType (B₁.law4 K p g b (q .gen) (q .init))) (∑ i, q i)))))

