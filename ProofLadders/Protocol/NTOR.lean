/-- **`B₂` at per-port budgets**: the program of `B₂` at the per-label call bound `B₂.calls`,
beside its sources. -/
def B₂.perLabel [DecidableEq K] [Nonempty K] (p : ℕ) [NeZero p] (g : G) (q : UAKE.Port → ℕ) :
    UAKE.perPort (G × G × G × G × G) (K × K) G (ZMod p) (G × ZMod p) G (G × K) K
        (q .gen) (q .init) q ⟶
