  (MultiStCDH.perPort G p (q .init) (q .respond) (cdhBudget₂ q)).tensor
    ((Interface.source (lawType (B₂.law1 K p g (q .gen) (q .init) (q .respond)))
        (∑ i, q i)).tensor
      ((Interface.source (lawType (B₂.law2 K p g (q .gen) (q .init) (q .respond)))
          (∑ i, q i)).tensor
        ((Interface.source (lawType (B₂.law3 K p g (q .gen) (q .init) (q .respond)))
            (∑ i, q i)).tensor
          (Interface.source (lawType (B₂.law4 K p g (q .gen) (q .init) (q .respond)))
            (∑ i, q i)))))

