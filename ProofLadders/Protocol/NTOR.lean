/-- The inside interface admits the per-label budget of `B₁`. -/
lemma B₁.admits [DecidableEq K] [Nonempty K] (p : ℕ) [NeZero p] (g : G) (b : Bool)
    (q : UAKE.Port → ℕ) :
    (B₁.inside (K := K) p g b q).AdmitsLabelBudget fun j => ∑ o, B₁.calls o j * q o := by
  refine ((portBudget_admitsLabelBudget _ _ _ _).tensor
    ((queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp)).tensor
      ((queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp)).tensor
        ((queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp)).tensor
          (queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp)))))).mono
    fun j => ?_
  rcases j with (_ | _ | _ | _ | _) | _ | _ | _ | _ <;>
    simp [Finset.univ, Fintype.elems, B₁.calls, cdhBudget₁]
  all_goals omega

/-- **`B₁,b` at per-port budgets**: the program of `B₁` at the per-label call bound `B₁.calls`,
beside its sources. -/
def B₁.perLabel [DecidableEq K] [Nonempty K] (p : ℕ) [NeZero p] (g : G) (b : Bool)
    (q : UAKE.Port → ℕ) :
    UAKE.perPort (G × G × G × G × G) (K × K) G (ZMod p) (G × ZMod p) G (G × K) K
        (q .gen) (q .init) q ⟶
      MultiStCDH.perPort G p (q .gen) (q .init) (cdhBudget₁ q) :=
  Converter.ofLabelBoundedProgram (A := UAKE.perPort (G × G × G × G × G) (K × K) G (ZMod p)
        (G × ZMod p) G (G × K) K (q .gen) (q .init) q)
      (B := B₁.inside (K := K) p g b q) none (B₁.body K p g b (q .gen) (q .init))
      (B₁.bound_spec K p g b (q .gen) (q .init)) B₁.calls
      (B₁.labelBounded p g b (q .gen) (q .init)) q (fun _ hd => hd.2) (B₁.admits p g b q) ≫
    Interface.rightContext _ (B₁.randomness K p g b (q .gen) (q .init) (∑ i, q i))

/-- The inside calls of `B₂` per procedure: `Gen₁` from `Init`, `Gen₂` from `Respond`,
`Corrupt₁` from `Expose`, one `DDH` query per oracle query, the oracles, and the keys and
exponents it samples. -/
def B₂.calls : UAKE.Port → MultiStCDH.Port ⊕ (Unit ⊕ (Unit ⊕ (Unit ⊕ Unit))) → ℕ
  | .init, .inl .gen₁ => 1
  | .respond, .inl .gen₂ => 1
  | .expose, .inl .corrupt₁ => 1
  | .hash, .inl .ddh => 1
  | _, .inr (.inl _) => 1
  | _, .inr (.inr (.inl _)) => 1
  | .gen, .inr (.inr (.inr (.inl _))) => 1
  | .respond, .inr (.inr (.inr (.inr _))) => 1
  | _, _ => 0

/-- `B₂` calls each inside label at most `B₂.calls` times per procedure. -/
lemma B₂.labelBounded [DecidableEq K] [Nonempty K] (p : ℕ) [NeZero p] (g : G)
    (qgen qinit qresp : ℕ) : (B₂.body K p g qgen qinit qresp).LabelBounded B₂.calls := by
  intro s o u
  cases o <;> simp only [B₂.body] <;> cases s <;> dsimp only <;>
    repeat' (first
      | exact Program.labelCallBound_return _ _
      | (refine Program.labelCallBound_call _ _ _ (by decide) fun y => ?_)
      | split)

/-- The inside interface of the program of `B₂`: `(q_init, q_resp)`-St-CDH beside the sources. -/
