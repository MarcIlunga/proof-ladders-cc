/-! ## Theorem 2 and Corollary 2 -/

/-- **Theorem 2** of [2]: for a group of prime order `p` generated by `g`, every solver's
key-indistinguishability advantage against `KE₅` is at most its winning probabilities for `B₁ 0`
and `B₁ 1` attached to `(q_gen, q_init)`-St-CDH and `B₂` attached to `(q_init, q_resp)`-St-CDH,
and the statistical terms. -/
theorem ntor [DecidableEq K] [Nonempty K] (p : ℕ) [NeZero p] (g : G)
    (order : Fintype.card G = p) (prime : p.Prime) (generator : Subgroup.zpowers g = ⊤)
    (q : UAKE.Port → ℕ) :
    ∀ s ∈ CompatibleSolverClass.solvers (UAKE.perPort (G × G × G × G × G) (K × K) G (ZMod p)
        (G × ZMod p) G (G × K) K (q .gen) (q .init) q),
      |s.1 (KeyExchange.IND.systems (KE₅ (K := K) p g) (q .gen) (q .init) q).1 -
          s.1 (KeyExchange.IND.systems (KE₅ (K := K) p g) (q .gen) (q .init) q).2| ≤
        s.2 (B₁.perLabel p g false q • StCDH.Multi.game p g (q .gen) (q .init) (cdhBudget₁ q)) +
          s.2 (B₁.perLabel p g true q • StCDH.Multi.game p g (q .gen) (q .init) (cdhBudget₁ q)) +
          s.2 (B₂.perLabel p g q • StCDH.Multi.game p g (q .init) (q .respond) (cdhBudget₂ q)) +
          (2 * q .init / Fintype.card K + 2 * q .gen * q .init / p +
            2 * q .hash * (q .init + q .respond) / p) := by
  -- The proof of [2]: for each bit, `G₀ → G₁` (a generated key equal to an earlier `Init`
  -- input, `q_gen q_init / p`), `G₁ → G₂` (internal oracles `H₁`, `H₂`, `H₃` and early queries,
  -- `q_H (q_init + q_resp)/p`), `G₂ → G₃` (a tag guessed without the oracle, `q_init/|K|`),
  -- `G₃ → G₄` (`bad₂`: a game hop whose winning is the `DDH` query of `B₁ b`, as `B₁ b`
  -- attached to `(q_gen, q_init)`-St-CDH is `G₄^b` until `bad₂`); then `G₄⁰ → G₄¹`, a game hop
  -- whose winning is the `DDH` query of `B₂`.
  sorry

/-- **Corollary 2** of [2]: every solver's key-indistinguishability advantage against `KE₅` is at
most `q_gen q_init` times its winning probabilities for `B₁ 0` and `B₁ 1` composed with `B` of
Lemma 1 attached to St-CDH, `q_init` times that for `B₂` composed with `B` of Lemma 1 without
`Corrupt₂` attached to St-CDH, and the statistical terms. -/
theorem ntor_single_user [DecidableEq K] [Nonempty K] (p : ℕ) [NeZero p] (g : G)
    (order : Fintype.card G = p) (prime : p.Prime) (generator : Subgroup.zpowers g = ⊤)
    (q : UAKE.Port → ℕ) [NeZero (q .gen)] [NeZero (q .init)] :
    ∀ s ∈ CompatibleSolverClass.solvers (UAKE.perPort (G × G × G × G × G) (K × K) G (ZMod p)
        (G × ZMod p) G (G × K) K (q .gen) (q .init) q),
      |s.1 (KeyExchange.IND.systems (KE₅ (K := K) p g) (q .gen) (q .init) q).1 -
          s.1 (KeyExchange.IND.systems (KE₅ (K := K) p g) (q .gen) (q .init) q).2| ≤
        q .gen * q .init * s.2 ((B₁.perLabel p g false q ≫
              MultiUser.StCDH.B.perLabel p g (q .gen) (q .init) (cdhBudget₁ q)) •
            StCDH.Single.game p g (MultiUser.stCDHBudget (cdhBudget₁ q))) +
          q .gen * q .init * s.2 ((B₁.perLabel p g true q ≫
              MultiUser.StCDH.B.perLabel p g (q .gen) (q .init) (cdhBudget₁ q)) •
            StCDH.Single.game p g (MultiUser.stCDHBudget (cdhBudget₁ q))) +
          q .init * s.2 ((B₂.perLabel p g q ≫
              MultiUser.StCDH.B.noCorrupt₂.perLabel p g (q .init) (q .respond) (cdhBudget₂ q)) •
            StCDH.Single.game p g (MultiUser.stCDHBudget (cdhBudget₂ q))) +
          (2 * q .init / Fintype.card K + 2 * q .gen * q .init / p +
            2 * q .hash * (q .init + q .respond) / p) := by
  -- Theorem then lemma: each multi-user game term is at most its factor times the single-user
  -- game with the lemma's reduction composed after the theorem's.
  intro s hs
  refine (ntor (K := K) p g order prime generator q s hs).trans ?_
  gcongr
  exacts [CompatibleSolverClass.win_attach_le_of_reduction _ _
      (MultiUser.multi_stCDH_le p g order prime generator (q .gen) (q .init) (cdhBudget₁ q)) hs,
    CompatibleSolverClass.win_attach_le_of_reduction _ _
      (MultiUser.multi_stCDH_le p g order prime generator (q .gen) (q .init) (cdhBudget₁ q)) hs,
    CompatibleSolverClass.win_attach_le_of_reduction _ _
      (MultiUser.multi_stCDH_le_of_no_corrupt₂ p g order prime generator (q .init) (q .respond)
        (cdhBudget₂ q) rfl) hs]

