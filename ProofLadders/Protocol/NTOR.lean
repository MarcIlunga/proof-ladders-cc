      (B := B₂.inside (K := K) p g q) none (B₂.body K p g (q .gen) (q .init) (q .respond))
      (B₂.bound_spec K p g (q .gen) (q .init) (q .respond)) B₂.calls
      (B₂.labelBounded p g (q .gen) (q .init) (q .respond)) q (fun _ hd => hd.2)
      (B₂.admits p g q) ≫
