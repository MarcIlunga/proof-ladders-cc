import ProofLadders.Protocol.MultiUser

/-!
# Signed Diffie–Hellman

Problem 2 of the protocol ladder [1, §2.2], in the computational model of [2]: the signed
Diffie–Hellman key exchange `KE₂` [2, Figure 7] over a group `G` of prime order `p` generated by
`g`, with a signature scheme `SIG` and a hash function `Hash : G³ → K` modeled as a random oracle.

$$\mathsf{init}(pk):\ x \leftarrow \mathbb{Z}_p,\ c = g^x; \qquad
\mathsf{resp}(sk, c):\ y \leftarrow \mathbb{Z}_p,\ \sigma \leftarrow \mathsf{SIG.sig}(sk, (c,
g^y)),\ k = \mathsf{Hash}(c, g^y, c^y);$$
$$\mathsf{recv}((pk, x), (g^y, \sigma)) = \mathsf{Hash}(g^x, g^y, (g^y)^x)
\text{ if } \mathsf{SIG.vfy}(pk, (g^x, g^y), \sigma), \text{ and } \bot \text{ otherwise}.$$

Theorem 1 of [2] bounds the key-indistinguishability advantage by twice the advantage of the
adversary `B₁` against `q_gen`-SUF-CMA, the advantage of the adversary `B₂` against
`(q_init, q_resp)`-St-CDH, and the statistical terms `2 q_init q_gen 2^{-γ}` and
`2 q_H (q_init + q_resp)/p`. The advantage is a solver's difference of decision probabilities
between `IND⁰` and `IND¹`, the converter `KeyExchange.IND b` on the real system of `KE₂`; the
adversaries are the solver with the reductions of [2, Figures 9 and 10] absorbed, one `B₁ b` for
each value of the challenge bit, and their advantages are winning probabilities of the
multi-user games.

The reductions are DSL converters from the key-exchange interface to the multi-user games. `B₁ b`
runs `G₂^b` of [2] with `Gen`, `Sign` and `Corrupt` of `q_gen`-SUF-CMA, and outputs a challenged
unpartnered `Receive` with a valid signature as its forgery, a verification query. `B₂` runs
`G₃` with `Init` on `Gen₁`, a partnered `Respond` on `Gen₂` and `Expose` on `Corrupt₁`, keys the
sessions with the internal oracle `H'`, and answers the oracle `H` at a Diffie–Hellman tuple of an
initiator's message, checked with `DDH`, from `H'`. As in `IND`, a `Respond` is partnered with
every initiator of intended partner `j` that sent `c`: its reply is recorded for all of them, and
it is challenged when none of them is exposed. After `Stop` a reduction makes no inside call and
answers `⊥`, and the oracle from its table. The oracles `H` and `H'` are sampled once, as in
`IND`, and the points where the table of `H` is set are recorded. `B₁ b` is typed at amortized
per-label inside budgets (`Interface.Converter.ofAmortizedProgram`): one inside query per query
of `Gen`, `Respond` and `Corrupt`, and one forgery, paid by a potential on its state until it
stops. `B₂` is typed at per-label inside budgets (`Interface.Converter.ofLabelBoundedProgram`):
one `DDH` query per oracle query and per unpartnered `Respond`, whose key is an oracle query.

Corollary 1 of [2] composes `B₁ b` with the reduction of Lemma 2, losing `q_gen`, and `B₂`, which
has no `Corrupt₂`, with that of Lemma 1 without `Corrupt₂`, losing `q_init`; the factor `2 q_gen`
of [2] is the sum over the two bits.

Style: systems for the key exchange and games for the assumptions; the games `G₀`–`G₃` of [2]
are hybrids, the bad events `bad₁` and the early oracle queries are statistical steps, and `bad₂`
and the final step are the two assumptions.

## Main definitions

* `KE₂ sig p g`: signed Diffie–Hellman
* `B₁ sig p g b`, `B₂ sig p g`: the reductions of [2, Figures 9 and 10], and their typings
  `.perLabel` at (amortized) per-label inside budgets
* `signingBudget`, `cdhBudget`: the budgets of `B₁` and `B₂`

## Main results

* `signed_dh_correct`: correctness, from the correctness of `SIG`
* `signed_dh`: Theorem 1 of [2]
* `signed_dh_single_user`: Corollary 1 of [2]

## References

1. The protocol ladder, `proof-ladders/protocol-ladder`, `Notes/main.tex`.
2. D. Riepel and P. Rösler. *Basic definitions, constructions, and proofs for unilateral
   authenticated key exchange*. The protocol ladder, `Notes/computational/main.pdf`, 2025.
-/

namespace ProofLadders.SignedDH

open CategoryTheory ConstructiveCryptography Commons Probability SystemAlgebra SystemAlgebra.DSL
  SystemAlgebra.Interface
open scoped SystemAlgebra SystemAlgebra.DSL

noncomputable section

variable {G : Type} [Group G] [Fintype G] [DecidableEq G] {p : ℕ} [NeZero p]
  {PK SK Sig K : Type} [Fintype PK] [Fintype SK] [Fintype Sig] [Fintype K]

/-- **Signed Diffie–Hellman** `KE₂` [2, Figure 7]. -/
def KE₂ (sig : SignatureScheme PK SK (G × G) Sig) (p : ℕ) [NeZero p] (g : G) :
    KeyExchange (G × G × G) K PK SK (PK × ZMod p) G (G × Sig) K where
  gen := Distribution.ProbDist.map Prod.swap sig.gen
  init _ pk := Distribution.ProbDist.map (fun x => ((pk, x), g ^ x.val)) 𝒰[ZMod p]
  resp H sk c := Distribution.ProbDist.bind 𝒰[ZMod p] fun y =>
    Distribution.ProbDist.map (fun σ => (some (H (c, g ^ y.val, c ^ y.val)), (g ^ y.val, σ)))
      (sig.sign sk (c, g ^ y.val))
  recv H st c' :=
    if sig.verify st.1 (g ^ st.2.val, c'.1) c'.2 then
      some (H (g ^ st.2.val, c'.1, c'.1 ^ st.2.val))
    else none

omit [Fintype G] [DecidableEq G] [Fintype PK] [Fintype SK] [Fintype Sig] [Fintype K] in
/-- **Correctness** [2, §3.1]: if `SIG` is correct, an honestly forwarded session gives both parties
`Hash(g^x, g^y, g^{xy})`. -/
theorem signed_dh_correct (sig : SignatureScheme PK SK (G × G) Sig) (g : G)
    (correct : sig.Correct) :
    (KE₂ (K := K) sig p g).Correct := by
  intro H keys hkeys start hstart response hresponse
  obtain ⟨⟨pk, sk⟩, hpk, rfl⟩ := Distribution.ProbDist.mem_support_map hkeys
  obtain ⟨x, -, rfl⟩ := Distribution.ProbDist.mem_support_map hstart
  obtain ⟨y, -, hy⟩ := Distribution.ProbDist.mem_support_bind hresponse
  obtain ⟨σ, hσ, rfl⟩ := Distribution.ProbDist.mem_support_map hy
  -- The signature on `(g^x, g^y)` verifies by `correct`, and `(g^y)^x = (g^x)^y`.
  have verifies : sig.verify pk (g ^ x.val, g ^ y.val) σ = true := correct pk sk hpk _ σ hσ
  refine ⟨rfl, ?_⟩
  simp only [KE₂, Prod.swap_prod_mk, verifies, if_true, ← pow_mul, mul_comm]

/-- The budget of `B₁` [2]: the `q_gen` users, `q_resp` signing queries, the corruptions and one
forgery. -/
def signingBudget (q : UAKE.Port → ℕ) : MultiSigning.Port → ℕ
  | .gen => q .gen
  | .sign => q .respond
  | .corrupt => q .corrupt
  | .verify => 1

/-- The budget of `B₂` [2]: the `q_init` and `q_resp` challenges, the exposures, no `Corrupt₂`,
and one `DDH` query per oracle query and per `Respond`. -/
def cdhBudget (q : UAKE.Port → ℕ) : MultiStCDH.Port → ℕ
  | .gen₁ => q .init
  | .gen₂ => q .respond
  | .corrupt₁ => q .expose
  | .corrupt₂ => 0
  | .ddh => q .hash + q .respond

/-! ## The reductions -/

-- `B₁,b` [2, Figure 9]: `Gen` takes `pk_m ← Gen'` and stops if an `Init` input `pk_m` has no
-- partner; `Init` samples `x ← ℤ_p`; `Respond(j, c, ch)` signs `(c, g^y)` with `Sign(j, ·)`, and
-- records its reply for every initiator `i` with `P[i] = j` that sent `c`; `Receive(i, c, ch)`
-- stops with the forgery `(P[i], (g^x, h), σ)` when the challenge is allowed and `k ≠ ⊥`;
-- `Corrupt(j)` is `Corrupt'(j)`; the rest as `IND^b`.
converter B₁(K : Type) [Fintype K] [Nonempty K] (sig : SignatureScheme PK SK (G × G) Sig) (p : ℕ) [NeZero p] (g : G) (b : Bool) (qgen qinit : ℕ) [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig] : UAKE (G × G × G) K PK SK (PK × ZMod p) G (G × Sig) K qgen qinit
  inside signing : MultiSigning PK SK (G × G) Sig qgen
  initialize
    H ←$ 𝒰[G × G × G → K]
    pks ← ([] : List PK)
    sessions ← ([] : List ((PK × ZMod p) × G × Option (Fin qgen)))
    received ← ([] : List (Fin qinit))
    challenged ← ([] : List (Fin qinit))
    exposed ← ([] : List (Fin qinit))
    corrupted ← ([] : List (Fin qgen))
    responses ← ([] : List (Fin qgen × Fin qinit × (G × Sig)))
    stopped ← false
  on gen() → Option PK
    if stopped
      return none
    else
      if pks.length < qgen
        issued ← signing.gen()
        match issued
        | none →
          return none
        | some pk →
          pks ← pks ++ [pk]
          if decide (∃ s ∈ sessions, s.1.1 = pk ∧ s.2.2 = none)
            stopped ← true
            return none
          else
            return some pk
      else
        return none
  on init(pk : PK) → Option G
    if stopped
      return none
    else
      if sessions.length < qinit
        x ←$ 𝒰[ZMod p]
        sessions ← sessions ++ [((pk, x), g ^ x.val,
          (List.finRange qgen).find? fun j => decide (pks[j.val]? = some pk))]
        return some (g ^ x.val)
      else
        return none
  on receive(i : Fin qinit, c : G × Sig, ch : Bool) → Option (Option K)
    if stopped
      return none
    else
      match sessions[i.val]?
      | none →
        return none
      | some (st, _c₁, P) →
        if decide (i ∈ received)
          return none
        else
          received ← received ++ [i]
          if decide (∃ j, P = some j ∧ (j, i, c) ∈ responses)
            return none
          else
            k ← (KE₂ sig p g).recv H st c
            if (ch && !decide (i ∈ exposed) && decide (∃ j, P = some j ∧ j ∉ corrupted) &&
                k.isSome)
              match P
              | none →
                return none
              | some j →
                _forged ← signing.verify(j, (g ^ st.2.val, c.1), c.2)
                stopped ← true
                return none
            else
              return some k
  on respond(j : Fin qgen, c : G, ch : Bool) → Option (Option K × (G × Sig))
    if stopped
      return none
    else
      match pks[j.val]?
      | none →
        return none
      | some _ →
        y ←$ 𝒰[ZMod p]
        signature ← signing.sign(j, (c, g ^ y.val))
        match signature
        | none →
          return none
        | some σ →
          partners ← (List.finRange qinit).filter (fun i =>
            decide (((sessions[i.val]?).map fun s => (s.2.2, s.2.1)) = some (some j, c)))
          if decide (partners = [])
            return some (some (H (c, g ^ y.val, c ^ y.val)), (g ^ y.val, σ))
          else
            responses ← responses ++ partners.map fun i => (j, i, (g ^ y.val, σ))
            if ch && decide (∀ i ∈ partners, i ∉ exposed)
              challenged ← challenged ++ partners
              if b
                k ←$ 𝒰[K]
                return some (some k, (g ^ y.val, σ))
              else
                return some (some (H (c, g ^ y.val, c ^ y.val)), (g ^ y.val, σ))
            else
              return some (some (H (c, g ^ y.val, c ^ y.val)), (g ^ y.val, σ))
  on corrupt(j : Fin qgen) → Option SK
    if stopped
      return none
    else
      match pks[j.val]?
      | none →
        return none
      | some _ →
        sk ← signing.corrupt(j)
        corrupted ← corrupted ++ [j]
        return sk
  on expose(i : Fin qinit) → Option (PK × ZMod p)
    if stopped
      return none
    else
      if decide (i ∈ challenged)
        return none
      else
        exposed ← exposed ++ (sessions[i.val]?).toList.map fun _ => i
        return (sessions[i.val]?).map Prod.fst
  on hash(x : G × G × G) → K
    return H x

-- `B₂` [2, Figure 10]: `Init` takes `c ← Gen₁` and keeps `st = (pk, ⊥)`; `Respond(j, c, ch)` takes
-- `h ← Gen₂` and keys with `H'(c, h)` when initiators `i` with `P[i] = j` sent `c`, recording its
-- reply for all of them, and otherwise samples `y` and keys with `H(c, g^y, c^y)`; `Receive` keys
-- a valid signature with `H'(g^x, h)` and stops when the challenge is allowed; `Expose(i)` is
-- `(pk, Corrupt₁(i))`; `H(X, Y, Z)` is `H'(X, Y)` when `X` is an initiator's message and
-- `DDH(X, Y, Z) = 1`.
converter B₂(K : Type) [Fintype K] [Nonempty K] (sig : SignatureScheme PK SK (G × G) Sig) (p : ℕ) [NeZero p] (g : G) (qgen qinit qresp : ℕ) [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig] : UAKE (G × G × G) K PK SK (PK × ZMod p) G (G × Sig) K qgen qinit
  inside cdh : MultiStCDH G p qinit qresp
  initialize
    (H, H') ←$ 𝒰[(G × G × G → K) × (G × G → K)]
    defined ← ([] : List (G × G × G))
    keys ← ([] : List (SK × PK))
    sessions ← ([] : List (PK × G × Option (Fin qgen)))
    received ← ([] : List (Fin qinit))
    challenged ← ([] : List (Fin qinit))
    exposed ← ([] : List (Fin qinit))
    corrupted ← ([] : List (Fin qgen))
    responses ← ([] : List (Fin qgen × Fin qinit × (G × Sig)))
    stopped ← false
  on gen() → Option PK
    if stopped
      return none
    else
      if keys.length < qgen
        key ←$ sig.gen
        keys ← keys ++ [(key.2, key.1)]
        if decide (∃ s ∈ sessions, s.1 = key.1 ∧ s.2.2 = none)
          stopped ← true
          return none
        else
          return some key.1
      else
        return none
  on init(pk : PK) → Option G
    if stopped
      return none
    else
      if sessions.length < qinit
        issued ← cdh.gen₁()
        match issued
        | none →
          return none
        | some c →
          sessions ← sessions ++ [(pk, c,
            (List.finRange qgen).find? fun j => decide ((keys[j.val]?).map Prod.snd = some pk))]
          return some c
      else
        return none
  on receive(i : Fin qinit, c : G × Sig, ch : Bool) → Option (Option K)
    if stopped
      return none
    else
      match sessions[i.val]?
      | none →
        return none
      | some (pk, c₁, P) →
        if decide (i ∈ received)
          return none
        else
          received ← received ++ [i]
          if decide (∃ j, P = some j ∧ (j, i, c) ∈ responses)
            return none
          else
            k ← if sig.verify pk (c₁, c.1) c.2 then some (H' (c₁, c.1)) else none
            if (ch && !decide (i ∈ exposed) && decide (∃ j, P = some j ∧ j ∉ corrupted) &&
                k.isSome)
              stopped ← true
              return none
            else
              return some k
  on respond(j : Fin qgen, c : G, ch : Bool) → Option (Option K × (G × Sig))
    if stopped
      return none
    else
      match keys[j.val]?
      | none →
        return none
      | some (sk, _) →
        partners ← (List.finRange qinit).filter (fun i =>
          decide (((sessions[i.val]?).map fun s => (s.2.2, s.2.1)) = some (some j, c)))
        if !decide (partners = [])
          issued ← cdh.gen₂()
          match issued
          | none →
            return none
          | some h →
            signatures ←$ sig.signatures
            responses ← responses ++ partners.map fun i => (j, i, (h, signatures (sk, (c, h))))
            if ch && decide (∀ i ∈ partners, i ∉ exposed)
              challenged ← challenged ++ partners
              return some (some (H' (c, h)), (h, signatures (sk, (c, h))))
            else
              return some (some (H' (c, h)), (h, signatures (sk, (c, h))))
        else
          y ←$ 𝒰[ZMod p]
          signatures ←$ sig.signatures
          if decide ((c, g ^ y.val, c ^ y.val) ∈ defined)
            return some (some (H (c, g ^ y.val, c ^ y.val)),
              (g ^ y.val, signatures (sk, (c, g ^ y.val))))
          else
            if decide (∃ s ∈ sessions, s.2.2 ≠ none ∧ s.2.1 = c)
              valid ← cdh.ddh(c, g ^ y.val, c ^ y.val)
              if valid
                return some (some (H' (c, g ^ y.val)),
                  (g ^ y.val, signatures (sk, (c, g ^ y.val))))
              else
                defined ← defined ++ [(c, g ^ y.val, c ^ y.val)]
                return some (some (H (c, g ^ y.val, c ^ y.val)),
                  (g ^ y.val, signatures (sk, (c, g ^ y.val))))
            else
              defined ← defined ++ [(c, g ^ y.val, c ^ y.val)]
              return some (some (H (c, g ^ y.val, c ^ y.val)),
                (g ^ y.val, signatures (sk, (c, g ^ y.val))))
  on corrupt(j : Fin qgen) → Option SK
    if stopped
      return none
    else
      corrupted ← corrupted ++ (keys[j.val]?).toList.map fun _ => j
      return (keys[j.val]?).map Prod.fst
  on expose(i : Fin qinit) → Option (PK × ZMod p)
    if stopped
      return none
    else
      if decide (i ∈ challenged)
        return none
      else
        match sessions[i.val]?
        | none →
          return none
        | some (pk, _, _) →
          exposed ← exposed ++ [i]
          x ← cdh.corrupt₁(i)
          return x.map fun x => (pk, x)
  on hash(X : G, Y : G, Z : G) → K
    if stopped
      return H (X, Y, Z)
    else
      if decide ((X, Y, Z) ∈ defined)
        return H (X, Y, Z)
      else
        if decide (∃ s ∈ sessions, s.2.2 ≠ none ∧ s.2.1 = X)
          valid ← cdh.ddh(X, Y, Z)
          if valid
            return H' (X, Y)
          else
            defined ← defined ++ [(X, Y, Z)]
            return H (X, Y, Z)
        else
          defined ← defined ++ [(X, Y, Z)]
          return H (X, Y, Z)

/-- The inside calls of `B₁` per procedure: one query of `q_gen`-SUF-CMA per query of `Gen`,
`Respond` and `Corrupt`, the oracle, and the exponents and keys it samples. -/
def B₁.calls : UAKE.Port → MultiSigning.Port ⊕ (Unit ⊕ (Unit ⊕ (Unit ⊕ Unit))) → ℕ
  | .gen, .inl .gen => 1
  | .respond, .inl .sign => 1
  | .corrupt, .inl .corrupt => 1
  | _, .inr (.inl _) => 1
  | .init, .inr (.inr (.inl _)) => 1
  | .respond, .inr (.inr (.inr _)) => 1
  | _, _ => 0

/-- The potential of `B₁`: the forgery until it stops. -/
def B₁.potential [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig] [Nonempty K]
    (sig : SignatureScheme PK SK (G × G) Sig) (p : ℕ) [NeZero p] (g : G) (b : Bool)
    (qgen qinit : ℕ) : Option (TypeOf (B₁.initial K sig p g b qgen qinit)) →
      MultiSigning.Port ⊕ (Unit ⊕ (Unit ⊕ (Unit ⊕ Unit))) → ℕ
  | none, .inl .verify => 1
  | some (_, _, _, _, _, _, _, _, stopped), .inl .verify => if stopped then 0 else 1
  | _, _ => 0

/-- `B₁` calls each inside label at most `B₁.calls` times per procedure, and the forgery once,
paid by `B₁.potential`. -/
lemma B₁.labelBounded [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig] [Nonempty K]
    (sig : SignatureScheme PK SK (G × G) Sig) (p : ℕ) [NeZero p] (g : G) (b : Bool)
    (qgen qinit : ℕ) :
    (B₁.body K sig p g b qgen qinit).LabelBoundedWith B₁.calls
      (B₁.potential sig p g b qgen qinit) := by
  intro s o u
  cases o <;> simp only [B₁.body] <;> cases s <;> dsimp only <;>
    repeat' (first
      | exact Program.labelCallBoundWith_return _ (by
          intro j; rcases j with (_ | _ | _ | _) | _ | _ | _ | _ <;>
            simp [B₁.calls, B₁.potential])
      | (refine Program.labelCallBoundWith_call _ _ _
          (by first | (simp [B₁.calls, B₁.potential]; done) | simp_all [B₁.calls, B₁.potential])
          fun y => ?_)
      | split)

/-- The inside interface of the program of `B₁`: `q_gen`-SUF-CMA beside the sources. -/
abbrev B₁.inside [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig] [Nonempty K]
    (sig : SignatureScheme PK SK (G × G) Sig) (p : ℕ) [NeZero p] (g : G) (b : Bool)
    (q : UAKE.Port → ℕ) : Interface :=
  (MultiSigning.perPort PK SK (G × G) Sig (q .gen) (signingBudget q)).tensor
    ((Interface.source (lawType (B₁.law1 K sig p g b (q .gen) (q .init))) (∑ i, q i)).tensor
      ((Interface.source (lawType (B₁.law2 K sig p g b (q .gen) (q .init)))
          (∑ i, q i)).tensor
        ((Interface.source (lawType (B₁.law3 K sig p g b (q .gen) (q .init)))
            (∑ i, q i)).tensor
          (Interface.source (lawType (B₁.law4 K sig p g b (q .gen) (q .init)))
            (∑ i, q i)))))

omit [Group G] in
/-- The inside interface admits the amortized per-label budget of `B₁`. -/
lemma B₁.admits [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig] [Nonempty K]
    (sig : SignatureScheme PK SK (G × G) Sig) (p : ℕ) [NeZero p] (g : G) (b : Bool)
    (q : UAKE.Port → ℕ) :
    (B₁.inside (K := K) sig p g b q).AdmitsLabelBudget fun j =>
      ∑ o, B₁.calls o j * q o + B₁.potential (K := K) sig p g b (q .gen) (q .init) none j := by
  refine ((portBudget_admitsLabelBudget _ _ _ _).tensor
    ((queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp)).tensor
      ((queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp)).tensor
        ((queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp)).tensor
          (queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp)))))).mono
    fun j => ?_
  rcases j with (_ | _ | _ | _) | _ | _ | _ | _ <;>
    simp [Finset.univ, Fintype.elems, B₁.calls, B₁.potential, signingBudget]
  all_goals omega

/-- **`B₁,b` at per-port budgets**: the program of `B₁` at the per-label call bound `B₁.calls`
with the potential `B₁.potential`, beside its sources. -/
def B₁.perLabel [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig] [Nonempty K]
    (sig : SignatureScheme PK SK (G × G) Sig) (p : ℕ) [NeZero p] (g : G) (b : Bool)
    (q : UAKE.Port → ℕ) :
    UAKE.perPort (G × G × G) K PK SK (PK × ZMod p) G (G × Sig) K (q .gen) (q .init) q ⟶
      MultiSigning.perPort PK SK (G × G) Sig (q .gen) (signingBudget q) :=
  Converter.ofAmortizedProgram
      (A := UAKE.perPort (G × G × G) K PK SK (PK × ZMod p) G (G × Sig) K (q .gen) (q .init) q)
      (B := B₁.inside (K := K) sig p g b q) none (B₁.body K sig p g b (q .gen) (q .init))
      (B₁.bound_spec K sig p g b (q .gen) (q .init)) B₁.calls
      (B₁.potential (K := K) sig p g b (q .gen) (q .init))
      (B₁.labelBounded (K := K) sig p g b (q .gen) (q .init)) q (fun _ hd => hd.2)
      (B₁.admits sig p g b q) ≫
    Interface.rightContext _ (B₁.randomness K sig p g b (q .gen) (q .init) (∑ i, q i))

/-- The inside calls of `B₂` per procedure: `Gen₁` from `Init`, `Gen₂` and `DDH` from `Respond`,
`Corrupt₁` from `Expose`, `DDH` from the oracle, the oracles, and the keys, exponents and
signatures it samples. -/
def B₂.calls : UAKE.Port → MultiStCDH.Port ⊕ (Unit ⊕ (Unit ⊕ (Unit ⊕ (Unit ⊕ Unit)))) → ℕ
  | .init, .inl .gen₁ => 1
  | .respond, .inl .gen₂ => 1
  | .expose, .inl .corrupt₁ => 1
  | .respond, .inl .ddh => 1
  | .hash, .inl .ddh => 1
  | _, .inr (.inl _) => 1
  | .gen, .inr (.inr (.inl _)) => 1
  | .respond, .inr (.inr (.inr _)) => 1
  | _, _ => 0

/-- `B₂` calls each inside label at most `B₂.calls` times per procedure. -/
lemma B₂.labelBounded [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig] [Nonempty K]
    (sig : SignatureScheme PK SK (G × G) Sig) (p : ℕ) [NeZero p] (g : G)
    (qgen qinit qresp : ℕ) : (B₂.body K sig p g qgen qinit qresp).LabelBounded B₂.calls := by
  intro s o u
  cases o <;> simp only [B₂.body] <;> cases s <;> dsimp only <;>
    repeat' (first
      | exact Program.labelCallBound_return _ _
      | (refine Program.labelCallBound_call _ _ _ (by decide) fun y => ?_)
      | split)

/-- The inside interface of the program of `B₂`: `(q_init, q_resp)`-St-CDH beside the sources. -/
abbrev B₂.inside [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig] [Nonempty K]
    (sig : SignatureScheme PK SK (G × G) Sig) (p : ℕ) [NeZero p] (g : G)
    (q : UAKE.Port → ℕ) : Interface :=
  (MultiStCDH.perPort G p (q .init) (q .respond) (cdhBudget q)).tensor
    ((Interface.source (lawType (B₂.law1 K sig p g (q .gen) (q .init) (q .respond)))
        (∑ i, q i)).tensor
      ((Interface.source (lawType (B₂.law2 K sig p g (q .gen) (q .init) (q .respond)))
          (∑ i, q i)).tensor
        ((Interface.source (lawType (B₂.law3 K sig p g (q .gen) (q .init) (q .respond)))
            (∑ i, q i)).tensor
          ((Interface.source
              (lawType (B₂.law4 K sig p g (q .gen) (q .init) (q .respond)))
              (∑ i, q i)).tensor
            (Interface.source
              (lawType (B₂.law5 K sig p g (q .gen) (q .init) (q .respond)))
              (∑ i, q i))))))

omit [Group G] in
/-- The inside interface admits the per-label budget of `B₂`. -/
lemma B₂.admits [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig] [Nonempty K]
    (sig : SignatureScheme PK SK (G × G) Sig) (p : ℕ) [NeZero p] (g : G)
    (q : UAKE.Port → ℕ) :
    (B₂.inside (K := K) sig p g q).AdmitsLabelBudget fun j => ∑ o, B₂.calls o j * q o := by
  refine ((portBudget_admitsLabelBudget _ _ _ _).tensor
    ((queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp)).tensor
      ((queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp)).tensor
        ((queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp)).tensor
          ((queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp)).tensor
            (queryBudget_admitsLabelBudget _ _ _ (fun _ => ∑ i, q i) (by simp))))))).mono
    fun j => ?_
  rcases j with (_ | _ | _ | _ | _) | _ | _ | _ | _ | _ <;>
    simp [Finset.univ, Fintype.elems, B₂.calls, cdhBudget]
  all_goals omega

/-- **`B₂` at per-port budgets**: the program of `B₂` at the per-label call bound `B₂.calls`,
beside its sources. -/
def B₂.perLabel [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig] [Nonempty K]
    (sig : SignatureScheme PK SK (G × G) Sig) (p : ℕ) [NeZero p] (g : G)
    (q : UAKE.Port → ℕ) :
    UAKE.perPort (G × G × G) K PK SK (PK × ZMod p) G (G × Sig) K (q .gen) (q .init) q ⟶
      MultiStCDH.perPort G p (q .init) (q .respond) (cdhBudget q) :=
  Converter.ofLabelBoundedProgram
      (A := UAKE.perPort (G × G × G) K PK SK (PK × ZMod p) G (G × Sig) K (q .gen) (q .init) q)
      (B := B₂.inside (K := K) sig p g q) none (B₂.body K sig p g (q .gen) (q .init) (q .respond))
      (B₂.bound_spec K sig p g (q .gen) (q .init) (q .respond)) B₂.calls
      (B₂.labelBounded (K := K) sig p g (q .gen) (q .init) (q .respond)) q (fun _ hd => hd.2)
      (B₂.admits sig p g q) ≫
    Interface.rightContext _
      (B₂.randomness K sig p g (q .gen) (q .init) (q .respond) (∑ i, q i))


/-! ## Theorem 1 and Corollary 1 -/

/-- **Theorem 1** of [2]: for a group of prime order `p` generated by `g` and a signature scheme
whose keys have `γ` bits of entropy, every solver's key-indistinguishability advantage against
`KE₂` is at most its winning probabilities for `B₁ 0` and `B₁ 1` attached to `q_gen`-SUF-CMA and
`B₂` attached to `(q_init, q_resp)`-St-CDH, and the statistical terms. -/
theorem signed_dh [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig] [DecidableEq K]
    [Nonempty K] (sig : SignatureScheme PK SK (G × G) Sig) (g : G)
    (order : Fintype.card G = p) (prime : p.Prime) (generator : Subgroup.zpowers g = ⊤)
    (γ : ℕ) (entropy : sig.KeyEntropy γ) (q : UAKE.Port → ℕ) :
    ∀ s ∈ CompatibleSolverClass.solvers
        (UAKE.perPort (G × G × G) K PK SK (PK × ZMod p) G (G × Sig) K (q .gen) (q .init) q),
      |s.1 (KeyExchange.IND.systems (KE₂ (K := K) sig p g) (q .gen) (q .init) q).1 -
          s.1 (KeyExchange.IND.systems (KE₂ (K := K) sig p g) (q .gen) (q .init) q).2| ≤
        s.2 (B₁.perLabel sig p g false q •
            SignatureScheme.MultiSUFCMA.game sig (q .gen) (signingBudget q)) +
          s.2 (B₁.perLabel sig p g true q •
            SignatureScheme.MultiSUFCMA.game sig (q .gen) (signingBudget q)) +
          s.2 (B₂.perLabel sig p g q • StCDH.Multi.game p g (q .init) (q .respond) (cdhBudget q)) +
          (2 * q .init * q .gen / 2 ^ γ + 2 * q .hash * (q .init + q .respond) / p) := by
  -- The proof of [2]: for each bit, `G₀ → G₁` (a generated key equal to an earlier `Init`
  -- input, `q_gen q_init 2^{-γ}` by `entropy`), `G₁ → G₂` (`bad₂`: a game hop whose winning is
  -- the forgery of `B₁ b`, as `B₁ b` attached to `q_gen`-SUF-CMA is `G₂^b` until `bad₂`),
  -- `G₂ → G₃` (early oracle queries, `q_H (q_init + q_resp)/p` by `order` and `generator`);
  -- then `G₃⁰ → G₃¹`, a game hop whose winning is the `DDH` query of `B₂` at the challenge keys.
  sorry

/-- **Corollary 1** of [2]: every solver's key-indistinguishability advantage against `KE₂` is at
most `q_gen` times its winning probabilities for `B₁ 0` and `B₁ 1` composed with `B` of Lemma 2
attached to SUF-CMA, `q_init` times that for `B₂` composed with `B` of Lemma 1 without `Corrupt₂`
attached to St-CDH, and the statistical terms. -/
theorem signed_dh_single_user [DecidableEq PK] [DecidableEq SK] [DecidableEq Sig]
    [DecidableEq K] [Nonempty K] (sig : SignatureScheme PK SK (G × G) Sig) (g : G)
    (order : Fintype.card G = p) (prime : p.Prime) (generator : Subgroup.zpowers g = ⊤)
    (γ : ℕ) (entropy : sig.KeyEntropy γ) (q : UAKE.Port → ℕ) [NeZero (q .gen)]
    [NeZero (q .init)] :
    ∀ s ∈ CompatibleSolverClass.solvers
        (UAKE.perPort (G × G × G) K PK SK (PK × ZMod p) G (G × Sig) K (q .gen) (q .init) q),
      |s.1 (KeyExchange.IND.systems (KE₂ (K := K) sig p g) (q .gen) (q .init) q).1 -
          s.1 (KeyExchange.IND.systems (KE₂ (K := K) sig p g) (q .gen) (q .init) q).2| ≤
        q .gen * s.2 ((B₁.perLabel sig p g false q ≫
              MultiUser.SUFCMA.B.perLabel sig (q .gen) (signingBudget q)) •
            SignatureScheme.SUFCMA.game sig (MultiUser.sufCMABudget (signingBudget q))) +
          q .gen * s.2 ((B₁.perLabel sig p g true q ≫
              MultiUser.SUFCMA.B.perLabel sig (q .gen) (signingBudget q)) •
            SignatureScheme.SUFCMA.game sig (MultiUser.sufCMABudget (signingBudget q))) +
          q .init * s.2 ((B₂.perLabel sig p g q ≫
              MultiUser.StCDH.B.noCorrupt₂.perLabel p g (q .init) (q .respond) (cdhBudget q)) •
            StCDH.Single.game p g (MultiUser.stCDHBudget (cdhBudget q))) +
          (2 * q .init * q .gen / 2 ^ γ + 2 * q .hash * (q .init + q .respond) / p) := by
  -- Theorem then lemma: each multi-user game term is at most its factor times the single-user
  -- game with the lemma's reduction composed after the theorem's.
  intro s hs
  refine (signed_dh (K := K) sig g order prime generator γ entropy q s hs).trans ?_
  gcongr
  exacts [CompatibleSolverClass.win_attach_le_of_reduction _ _
      (MultiUser.multi_sufCMA_le sig (q .gen) (signingBudget q)) hs,
    CompatibleSolverClass.win_attach_le_of_reduction _ _
      (MultiUser.multi_sufCMA_le sig (q .gen) (signingBudget q)) hs,
    CompatibleSolverClass.win_attach_le_of_reduction _ _
      (MultiUser.multi_stCDH_le_of_no_corrupt₂ p g order prime generator (q .init) (q .respond)
        (cdhBudget q) rfl) hs]

end

end ProofLadders.SignedDH
